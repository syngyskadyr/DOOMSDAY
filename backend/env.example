# Copy to repository-root .env, then fill provider settings locally.
# Never add .env or an API key to Git or to a frontend bundle.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_STYLE=chat_completions
LLM_STRUCTURED_OUTPUT=json_schema
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=2
# Optional positive generation cap (including thinking); e.g. 4096 for Brev.
LLM_MAX_OUTPUT_TOKENS=
# Separate frontend dev-server origins, comma-separated; empty = same-origin only.
DOOMSDAY_CORS_ORIGINS=
# Optional provider prices, USD per million tokens. Empty means unknown.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Optional SQLite override; otherwise backend/data/doomsday.sqlite3.
# DOOMSDAY_DB_PATH=backend/data/doomsday.sqlite3
