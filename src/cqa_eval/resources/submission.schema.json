{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Project validation schema derived from CQA_Student_Guide_Appendix_Results.pdf, pages 1-3; the organizer supplied the PDF example and rules.",
  "title": "CQA organizer results JSON 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "team_name", "model", "results"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "team_name": {"type": "string", "pattern": "\\S"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "name"],
      "properties": {
        "mode": {"enum": ["local", "external_api", "hybrid"]},
        "name": {"type": "string", "pattern": "\\S"}
      }
    },
    "results": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/ok"}, {"$ref": "#/$defs/error"}]}}
  },
  "$defs": {
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "value", "rationale", "evidence_turns"],
      "properties": {
        "criterion_id": {"enum": ["contact", "discovery", "identification", "consultation", "empathy", "dialogue", "closure", "critical"]},
        "value": {},
        "rationale": {"type": "string", "pattern": "\\S"},
        "evidence_turns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      },
      "allOf": [
        {"if": {"properties": {"criterion_id": {"enum": ["contact", "empathy", "critical"]}}}, "then": {"properties": {"value": {"type": "boolean"}}}},
        {"if": {"properties": {"criterion_id": {"enum": ["discovery", "identification", "closure"]}}}, "then": {"properties": {"value": {"type": ["boolean", "null"]}}}},
        {"if": {"properties": {"criterion_id": {"const": "consultation"}}}, "then": {"properties": {"value": {"type": ["integer", "null"], "enum": [0, 5, 10, 15, 20, null]}}}},
        {"if": {"properties": {"criterion_id": {"const": "dialogue"}}}, "then": {"properties": {"value": {"type": "integer", "enum": [0, 4, 7, 10]}}}}
      ]
    },
    "ok": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_id", "status", "criteria", "score"],
      "properties": {
        "conversation_id": {"type": "string", "pattern": "\\S"},
        "status": {"const": "ok"},
        "criteria": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {"$ref": "#/$defs/criterion"},
          "allOf": [
            {"contains": {"properties": {"criterion_id": {"const": "contact"}}, "required": ["criterion_id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"criterion_id": {"const": "discovery"}}, "required": ["criterion_id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"criterion_id": {"const": "identification"}}, "required": ["criterion_id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"criterion_id": {"const": "consultation"}}, "required": ["criterion_id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"criterion_id": {"const": "empathy"}}, "required": ["criterion_id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"criterion_id": {"const": "dialogue"}}, "required": ["criterion_id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"criterion_id": {"const": "closure"}}, "required": ["criterion_id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"criterion_id": {"const": "critical"}}, "required": ["criterion_id"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "score": {
          "type": "object", "additionalProperties": false,
          "required": ["final_score", "critical_flag"],
          "properties": {
            "final_score": {"type": "number", "minimum": 0, "maximum": 100},
            "critical_flag": {"type": "boolean"}
          }
        }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_id", "status", "criteria", "score", "error"],
      "properties": {
        "conversation_id": {"type": "string", "pattern": "\\S"},
        "status": {"const": "error"},
        "criteria": {"type": "array", "maxItems": 0},
        "score": {"type": "null"},
        "error": {"type": "string", "pattern": "\\S"}
      }
    }
  }
}
