# Скопировать в корень проекта как .env и заполнить локально.
# Значения BASE_URL/MODEL/API_STYLE брать из документации выбранного сервиса.
# Сильная модель Codex и модель внутри вашего приложения могут быть разными.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Допустимые значения реализуемого адаптера: chat_completions или responses.
# Выбор должен соответствовать реальному провайдеру. Не все провайдеры поддерживают оба.
LLM_API_STYLE=chat_completions
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=2
LLM_CONCURRENCY=1
LLM_MAX_LIVE_DIALOGUES=1
# Необязательные цены, USD за миллион токенов; пусто = стоимость неизвестна.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

